---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BlogHeader from "../../components/BlogHeader.astro";
import BlogMeta from "../../components/BlogMeta.astro";
import ImageViewer from "../../components/ImageViewer.astro";
import MarkdownContent from "../../components/MarkdownContent.astro";
import Layout from "../../layouts/Layout.astro";
import { getPosts, readingTime } from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | AarusPortfolio`} description={post.data.description} type="article">
  <main id="main-content" class="page">
    <article class="article">
      <BlogHeader title={post.data.title} description={post.data.description}>
        <BlogMeta date={post.data.date} minutes={readingTime(post.body)} />
      </BlogHeader>

      <MarkdownContent>
        <Content />
      </MarkdownContent>
    </article>

    <ImageViewer />
  </main>
</Layout>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-code-copy]");
    const code = button?.closest("figure")?.querySelector("pre code");
    if (!button || !code) return;

    try {
      await navigator.clipboard.writeText(code.textContent ?? "");
      button.textContent = "Copied";
    } catch {
      button.textContent = "Failed";
    }

    setTimeout(() => {
      button.textContent = "Copy";
    }, 1800);
  });
</script>

<style>
.page {
  min-height: 100vh;
  padding: 7.5rem var(--container-padding) 5rem;
}

.article {
  max-width: var(--content-width);
  margin: 0 auto;
}

@media (max-width: 768px) {
  .page {
    padding-top: 6.5rem;
  }
}
</style>
