---
import AchievementCard from "../components/AchievementCard.astro";
import ImageViewer from "../components/ImageViewer.astro";
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
import CS50P from "../assets/certs/CS50P.png";
import IITM from "../assets/certs/IITM.png";
import IITR from "../assets/certs/IITR.png";
import Incognito from "../assets/certs/Incognito.png";
import Lumi from "../assets/certs/Lumi.png";
import Silico from "../assets/certs/Silico.png";

const achievements = [
  {
    title: "CS50 Python Completion!",
    detail: "Harvard University",
    description:
      "Completed Harvard's CS50 Introduction to Programming with Python and received the official completion certificate.",
    image: CS50P,
    imageAlt: "CS50 Python Completion Certificate awarded by Harvard University.",
  },
  {
    title: "Level Zero, Game Dev Competition, 2nd Position!",
    detail: "Silico Battles v22.1 • Ahlcon Public School",
    description:
      "Won second prize in the game development competition held during Level Zero at Silico Battles v22.1.",
    image: Silico,
    imageAlt: "Silico Battle v22.1 Trophy and Cert!",
  },
  {
    title: "Turing Complete Python and DSA, 3rd Position!",
    detail: "Incognito Mark X • Somerville School Noida",
    description:
      "Placed third after competing with participants from 15 schools in the Python and DSA competition.",
    image: Incognito,
    imageAlt: "Incognito Mark X Trophy and Cert!",
  },
  {
    title: "GambitoR 4.0, IIT Roorkee, Certificate of Excellence!",
    detail: "One of the Top 80 Students across India!",
    description:
      "Qualified through maths, science, and reasoning preliminaries with over 10,000 students, earning a three day IIT Roorkee trip.",
    image: IITR,
    imageAlt: "GambitoR 4.0 Certificate of Excellence!",
  },
  {
    title: "Shaastra 2026, IIT Madras!",
    detail: "One of the 10 students selected for the Final Round!",
    description:
      "Advanced through rigorous Python and DSA, maths, and reasoning rounds against students from class 9 through college fourth year.",
    image: IITM,
    imageAlt: "Shaastra 2026 Participation Certificate.",
  },
  {
    title: "Lumi International Hackathon!",
    detail: "4th Position • $200 Prize",
    description:
      "Created HyprWeb, a WebOS that replicates Arch Linux and Hyprland. The project impressed judges, and the CEO of Lumi shared the achievement publicly.",
    image: Lumi,
    imageAlt: "Tweet by Lumi's CEO, for my achievement.",
  },
];
---

<Layout
  title="Achievements | AarusPortfolio"
  description="Selected awards, competition results, and project milestones by Aarav Gupta."
>
  <main id="main-content" class="page">
    <PageHeader
      title="Achievements"
      description="A collection of competitions, milestones, and work I am proud of."
    />

    <div class="achievementList">
      {achievements.map((achievement) => (
        <AchievementCard {...achievement} />
      ))}
    </div>

    <ImageViewer />
  </main>
</Layout>

<style>
.page {
  min-height: 100vh;
  padding: 8rem var(--container-padding) 5rem;
}

.achievementList {
  columns: 2;
  column-gap: 1rem;
  max-width: 58rem;
  margin: 0 auto;
}

@media (max-width: 760px) {
  .page {
    padding-top: 6.5rem;
  }

  .achievementList {
    columns: 1;
  }
}
</style>
