---
import { getCollection } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";
import { withRepoStats } from "../utils/github";

const projects = (await withRepoStats(await getCollection("projects"))).sort(
  (a, b) => a.data.order - b.data.order || b.stars - a.stars,
);
---

<Layout
  title="Projects | AarusPortfolio"
  description="Mod managers, launchers, games, and tools built by Aarav Gupta."
>
  <main id="main-content" class="page">
    <PageHeader
      title="Projects"
      description="Things I have built, from mod managers and launchers to games and tools I wanted to exist."
    />

    <div class="projects">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tech={project.data.tech}
          github={project.data.github}
          live={project.data.live}
          buttons={project.data.buttons}
          stars={project.stars}
        />
      ))}
    </div>
  </main>
</Layout>

<style>
.page {
  min-height: 100vh;
  padding: 8rem var(--container-padding) 5rem;
}

.projects {
  display: grid;
  gap: 1rem;
  max-width: var(--content-width);
  margin: 0 auto;
}

@media (max-width: 640px) {
  .page {
    padding-top: 6.5rem;
  }
}
</style>
