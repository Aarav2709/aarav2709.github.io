---
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
import { formatDate, getPosts, readingTime } from "../utils/blog";

const posts = await getPosts();
---

<Layout title="Blog | AarusPortfolio" description="Thoughts, devlogs, experiments, and things I learn while building.">
  <main id="main-content" class="page">
    <PageHeader title="Blog" description="Thoughts, devlogs, experiments, and things I learn while building." />

    <ul class="posts">
      {posts.map((post) => (
        <li class="reveal">
          <a href={`/blog/${post.id}`} class="surface post">
            <p class="muted">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true"> · </span>
              {readingTime(post.body)} min read
            </p>
            <h2>{post.data.title}</h2>
            <p class="description">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
.page {
  min-height: 100vh;
  padding: 8rem var(--container-padding) 5rem;
}

.posts {
  display: grid;
  gap: 1rem;
  max-width: var(--content-width);
  margin: 0 auto;
  list-style: none;
}

.post {
  display: grid;
  gap: 0.5rem;
  padding: 1.4rem 1.5rem;
  color: inherit;
}

h2 {
  color: var(--accent-color);
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.description {
  color: var(--secondary-text);
  line-height: 1.6;
}

@media (max-width: 640px) {
  .page {
    padding-top: 6.5rem;
  }

  .post {
    padding: 1.2rem;
  }
}
</style>
