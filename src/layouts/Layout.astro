---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import CustomCursor from "../components/CustomCursor.astro";
import Footer from "../components/Footer.astro";
import { getAge } from "../utils/age";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {
  title = "AarusPortfolio",
  description = `${getAge()} year old developer building software, games, and web experiences with Go, TypeScript, Lua, and Python.`,
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {}
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="AarusPortfolio Blog" href="/rss.xml" />
    <link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="author" content="Aarav Gupta" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#232d31" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AarusPortfolio" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AarusPortfolio by Aarav Gupta" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@Aarav2709" />

    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="a57c9b79-c0d0-48fd-b98c-9e083aac446b"
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Aarav Gupta",
        url: Astro.site?.toString(),
        sameAs: [
          "https://github.com/Aarav2709",
          "https://linkedin.com/in/aarav2709",
        ],
        jobTitle: "Developer",
        description,
        knowsAbout: [
          "Go",
          "TypeScript",
          "Python",
          "Lua",
          "Astro",
          "Game Development",
          "Open Source",
        ],
      })}
    />
  </head>

  <body>
    <CustomCursor />

    <NavBar />

    <slot />

    {!isHome && <Footer />}

    <script>
      import "../scripts/smoothScroll";

      const STAGGER_MS = 80;
      const MAX_STAGGER_STEPS = 5;

      function initReveal() {
        const elements = document.querySelectorAll<HTMLElement>(".reveal");

        if (!("IntersectionObserver" in window)) {
          elements.forEach((element) => element.classList.add("visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            // Stagger only elements that appear together.
            const appearing = entries.filter((entry) => entry.isIntersecting);

            appearing.forEach((entry, index) => {
              const element = entry.target as HTMLElement;
              const step = Math.min(index, MAX_STAGGER_STEPS);

              element.style.transitionDelay = `${step * STAGGER_MS}ms`;
              element.classList.add("visible");
              observer.unobserve(element);
            });
          },
          {
            threshold: 0.15,
          },
        );

        elements.forEach((element) => observer.observe(element));
      }

      initReveal();

      console.log(
        "%c> aarav.init()",
        "color: #fff; font-family: monospace; font-size: 14px; font-weight: bold;",
      );

      console.log(
        "%cBuilder. Full stack web dev. Open source enjoyer :D",
        "color: #888; font-family: monospace; font-size: 11px;",
      );
    </script>
  </body>
</html>
