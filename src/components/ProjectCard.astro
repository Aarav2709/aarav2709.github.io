---
interface Props {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  live?: string;
  buttons?: {
    text: string;
    url: string;
  }[];
  stars?: number;
}

const {
  title,
  description,
  tech,
  github,
  live,
  buttons = [],
  stars = 0,
} = Astro.props;

const links = [
  ...(github ? [{ text: "Source", url: github }] : []),
  ...(live ? [{ text: "Live", url: live }] : []),
  ...buttons,
];
---

<article class="surface project reveal">
  <div class="top">
    <h2>{title}</h2>
    {github && (
      <p class="stars" aria-label={`${stars} GitHub ${stars === 1 ? "star" : "stars"}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2.8l2.84 5.75 6.35.92-4.6 4.48 1.09 6.32L12 17.29l-5.68 2.98 1.09-6.32-4.6-4.48 6.35-.92L12 2.8Z" />
        </svg>
        {stars}
      </p>
    )}
  </div>

  <p class="description">{description}</p>

  <div class="bottom">
    <ul class="tech" aria-label="Built with">
      {tech.map((item) => <li class="tag">{item}</li>)}
    </ul>

    <div class="links">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="button ext">
          {link.text}
        </a>
      ))}
    </div>
  </div>
</article>

<style>
.project {
  display: grid;
  gap: 0.75rem;
  padding: 1.4rem 1.5rem;
}

.top {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.3rem 1rem;
}

h2 {
  color: var(--accent-color);
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.stars {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  color: var(--tertiary-text);
  font-size: 0.9rem;
  font-weight: 600;
}

.stars svg {
  width: 1rem;
  height: 1rem;
  color: var(--yellow);
}

.description {
  color: var(--secondary-text);
  line-height: 1.65;
}

.bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 0.25rem;
}

.tech,
.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  list-style: none;
}

.links .button {
  padding: 0.35rem 0.8rem;
  font-size: 0.85rem;
}
</style>
