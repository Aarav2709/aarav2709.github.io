---
const navLinks = [
  { name: "Home", url: "/" },
  { name: "About", url: "/about" },
  { name: "Projects", url: "/projects" },
  { name: "Blog", url: "/blog" },
  { name: "Achievements", url: "/achievements" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (url: string) =>
  url === currentPath || (url !== "/" && currentPath.startsWith(`${url}/`));
---

<a href="#main-content" class="skip-link">
  Skip to main content
</a>

<header id="site-nav">
  <nav aria-label="Main">
    <ul class="links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.url}
            class:list={{ active: isActive(link.url) }}
            aria-current={isActive(link.url) ? "page" : undefined}
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <button type="button" id="theme-toggle" class="iconButton" aria-label="Switch to light theme">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor" />
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8" />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
      </svg>
    </button>

    <button
      type="button"
      id="menu-toggle"
      class="iconButton menuToggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <ul id="mobile-menu" class="mobileMenu" inert>
    {navLinks.map((link) => (
      <li>
        <a
          href={link.url}
          class:list={{ active: isActive(link.url) }}
          aria-current={isActive(link.url) ? "page" : undefined}
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
const header = document.querySelector<HTMLElement>("#site-nav");
const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
const menu = document.querySelector<HTMLElement>("#mobile-menu");
const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
const root = document.documentElement;

function syncThemeToggle() {
  const next = root.dataset.theme === "light" ? "dark" : "light";
  themeToggle?.setAttribute("aria-label", `Switch to ${next} theme`);
}

function applyTheme(theme: string) {
  root.dataset.theme = theme;
  syncThemeToggle();
}

themeToggle?.addEventListener("click", () => {
  const theme = root.dataset.theme === "light" ? "dark" : "light";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Crossfade the whole page where supported.
  if (document.startViewTransition && !reduceMotion) {
    document.startViewTransition(() => applyTheme(theme));
  } else {
    applyTheme(theme);
  }

  try {
    localStorage.setItem("theme", theme);
  } catch {}
});

syncThemeToggle();

function setMenu(open: boolean) {
  if (!menu) return;

  header?.classList.toggle("menuOpen", open);
  menu.inert = !open;
  menuToggle?.setAttribute("aria-expanded", String(open));
  menuToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
}

menuToggle?.addEventListener("click", () => setMenu(!header?.classList.contains("menuOpen")));

menu?.querySelectorAll("a").forEach((link) => {
  link.addEventListener("click", () => setMenu(false));
});

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && header?.classList.contains("menuOpen")) {
    setMenu(false);
    menuToggle?.focus();
  }
});

document.addEventListener("click", (event) => {
  if (!header?.contains(event.target as Node)) setMenu(false);
});

window.matchMedia("(min-width: 821px)").addEventListener("change", (event) => {
  if (event.matches) setMenu(false);
});

let lastY = window.scrollY;
let ticking = false;

function updateNav() {
  ticking = false;

  const y = window.scrollY;
  const delta = y - lastY;

  // Ignore tiny scroll jitter.
  if (Math.abs(delta) < 6) return;

  const hide = delta > 0 && y > 80 && !header?.classList.contains("menuOpen");
  header?.classList.toggle("hidden", hide);
  lastY = y;
}

window.addEventListener(
  "scroll",
  () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateNav);
    }
  },
  { passive: true },
);

header?.addEventListener("focusin", () => header.classList.remove("hidden"));
</script>

<style>
#site-nav {
  position: fixed;
  top: 1rem;
  left: 50%;
  z-index: 1000;
  width: max-content;
  max-width: calc(100% - 2rem);
  transform: translateX(-50%);
  transition: translate 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
}

#site-nav.hidden {
  translate: 0 calc(-100% - 1.5rem);
  opacity: 0;
}

nav,
.mobileMenu {
  border-radius: 1.6rem;
  background: var(--glass-bg);
  box-shadow: var(--edge-highlight), var(--shadow);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
}

nav {
  display: flex;
  align-items: center;
  gap: 0.15rem;
  padding: 0.4rem;
}

.links,
.mobileMenu {
  list-style: none;
}

.links {
  display: flex;
  gap: 0.15rem;
}

.links a,
.mobileMenu a {
  display: block;
  padding: 0.5rem 0.85rem;
  border-radius: 999px;
  color: var(--secondary-text);
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1.2;
  transition: background-color 0.2s ease, color 0.2s ease, transform var(--spring);
}

.links a:hover,
.mobileMenu a:hover {
  background: var(--surface-hover);
  color: var(--primary-text);
}

.links a:active,
.mobileMenu a:active {
  transform: var(--active);
}

.links a.active,
.mobileMenu a.active {
  background: var(--accent-alpha);
  box-shadow: var(--edge-highlight);
  color: var(--accent-color);
}

.iconButton {
  display: grid;
  place-items: center;
  width: 2.2rem;
  height: 2.2rem;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--secondary-text);
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, transform var(--spring);
}

.iconButton:hover {
  background: var(--surface-hover);
  color: var(--accent-color);
}

.iconButton:active {
  transform: var(--active);
}

.iconButton svg {
  width: 1.1rem;
  height: 1.1rem;
}

.icon-moon,
:global([data-theme="light"]) .icon-sun {
  display: none;
}

:global([data-theme="light"]) .icon-moon {
  display: block;
}

.menuToggle,
.mobileMenu {
  display: none;
}

.skip-link {
  position: fixed;
  top: 0.75rem;
  left: 0.75rem;
  z-index: 2000;
  padding: 0.6rem 1rem;
  border-radius: var(--rounded-corner-small);
  background: var(--accent-color);
  color: var(--on-accent);
  transform: translateY(-200%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: none;
  color: var(--on-accent);
}

@media (max-width: 820px) {
  .links {
    display: none;
  }

  .menuToggle {
    display: grid;
  }

  .mobileMenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    display: grid;
    gap: 0.15rem;
    width: 14rem;
    translate: -50% 0;
    padding: 0.4rem;
    border-radius: var(--rounded-corner);
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.98);
    transform-origin: top center;
    pointer-events: none;
    transition: opacity 0.2s ease, transform var(--spring);
  }

  .menuOpen .mobileMenu {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  #site-nav,
  .mobileMenu {
    transition: none;
  }
}
</style>
