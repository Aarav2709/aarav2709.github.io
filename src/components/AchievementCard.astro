---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  detail?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description,
  detail,
  image,
  imageAlt = "",
} = Astro.props;

// Full-size WebP for the viewer.
const fullImage = image
  ? await getImage({ src: image, width: 1600, format: "webp" })
  : undefined;
---

<article class="surface achievementCard reveal">
  {image && fullImage && (
    <button
      type="button"
      class="preview"
      data-viewer-src={fullImage.src}
      data-viewer-alt={imageAlt}
      aria-label={`View ${title}`}
    >
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 700, 1000]}
        sizes="(max-width: 760px) 100vw, 29rem"
        format="webp"
        loading="lazy"
      />
      <span aria-hidden="true">View image</span>
    </button>
  )}

  <div class="content">
    {detail && <p class="muted">{detail}</p>}
    <h2>{title}</h2>
    <p class="description">{description}</p>
  </div>
</article>

<style>
.achievementCard {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  break-inside: avoid;
  margin-bottom: 1rem;
}

.preview {
  position: relative;
  display: block;
  width: 100%;
  overflow: hidden;
  padding: 0;
  border: 0;
  background: var(--bg-panel-strong);
  cursor: zoom-in;
}

.preview img {
  display: block;
  width: 100%;
  height: auto;
  transition: transform 0.4s ease;
}

.preview:hover img {
  transform: scale(1.02);
}

.preview span {
  position: absolute;
  right: 0.75rem;
  bottom: 0.75rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  background: rgba(20, 26, 28, 0.7);
  color: #f3f1e8;
  font-size: 0.78rem;
  font-weight: 600;
  opacity: 0;
  backdrop-filter: blur(8px);
  transition: opacity 0.2s ease;
}

.preview:hover span,
.preview:focus-visible span {
  opacity: 1;
}

.content {
  display: grid;
  gap: 0.5rem;
  padding: 1.3rem 1.4rem 1.5rem;
}

h2 {
  color: var(--accent-color);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.2;
}

.description {
  color: var(--secondary-text);
  font-size: 0.95rem;
  line-height: 1.65;
}
</style>
